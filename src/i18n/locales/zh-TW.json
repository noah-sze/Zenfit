      "metricGuides": {
        "weight": {
          "desc": "人體全部組織與水分的總物理質量，為能量平衡與體態變化的核心基準常數。",
          "method": "清晨空腹排便後，裸身或穿著貼身內衣，赤足立於水平硬質地面的電子秤中央測量。"
        },
        "bodyFat": {
          "desc": "體內脂肪總重量佔全身體重的百分比，用於評估瘦體重與體脂肪分佈現況。",
          "method": "使用生物電阻體脂儀 (BIA)、雙能 X 射線吸收儀 (DEXA) 或皮褶厚度計於固定生理狀態下測量。"
        },
        "shouldersCm": {
          "desc": "雙側三角肌最外緣突起點之間的橫向水平寬度，量化上半身骨架骨骼與肌肉寬度。",
          "method": "自然直立放鬆雙肩，雙臂自然垂於體側，皮尺水平繞過兩側三角肌中束最寬突出處測量。"
        },
        "chestCm": {
          "desc": "胸廓與胸大肌最高處的周長，評估胸腔結構與胸背肌群發達程度。",
          "method": "自然站立，雙臂張開後放鬆自然下垂，皮尺水平繞經胸大肌乳頭連線與背闊肌下方，正常呼吸末期讀取。"
        },
        "waistCm": {
          "desc": "腹部最窄處或臍部水平周長，為內臟脂肪蓄積與體態倒三角幾何比例的核心指標。",
          "method": "直立放鬆腹部（不縮腹、不鼓腹），皮尺水平繞過肚臍上方肋骨下緣與骨盆髂骨上脊之中間最窄處，正常呼氣後測量。"
        },
        "hipsCm": {
          "desc": "臀大肌向後最突出處的骨盆水平周長，用於腰臀比推算與下肢骨盆幾何評估。",
          "method": "雙腳併攏自然直立，皮尺水平環繞臀部最飽滿、最突出之處，確認前後等高貼平肌膚測量。"
        },
        "armsCm": {
          "desc": "上臂肱二頭肌與肱三頭肌區域的最大水平周長，客觀量化上肢肌群維度。",
          "method": "自然下垂放鬆或用力屈臂收縮（保持固定基準），皮尺環繞上臂肱二頭肌峰最豐滿處垂直於肱骨測量。"
        },
        "thighsCm": {
          "desc": "股四頭肌與膕旁肌最發達處的水平周長，反映下肢主要推拉肌群質量。",
          "method": "微張雙腳均勻受力，皮尺水平環繞臀摺下方或大腿中上段最粗處，貼平皮膚且不勒緊讀取。"
        },
        "calvesCm": {
          "desc": "小腿腓腸肌與比目魚肌最豐滿部位的水平周長，量化小腿肌群結構。",
          "method": "直立放鬆雙腿，重量均勻分佈，皮尺水平繞過小腿腹部最突出飽滿之最大圍度處測量。"
        }
      },
