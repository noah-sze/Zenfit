        "trendWeight": {
          "title": "平滑體重",
          "formula": "7 天生理平滑 (今日 15% + 歷史 85%)",
          "desc": "單日過磅易受水分滯留、高鈉飲食與胃腸殘留干擾，常產生 1~2 kg 的短期浮動。以 85% 歷史基底搭配 15% 當日過磅進行 7 天平滑避震，過濾日常噪音，真實呈現脂肪與肌肉組織的長期客觀走向。"
        },
        "bmi": {
          "title": "BMI 指數",
          "formula": "體重 (kg) / 身高 (m)²",
          "desc": "世界衛生組織評估身高與體重比例的基礎通用指標，客觀量化整體身形常數。"
        },
        "ffmi": {
          "title": "FFMI 去脂指數",
          "formula": "去脂體重 (kg) / 身高 (m)²",
          "desc": "排除體脂干擾之瘦體重密度指標，精準衡量骨骼肌相對身高的客觀發達程度。"
        },
        "leanBodyMass": {
          "title": "去脂體重",
          "formula": "體重 × (1 - 體脂率)",
          "desc": "身體扣除全部脂肪組織後的淨質量，涵蓋骨骼、肌肉、內臟組織與水分。"
        },
        "fatMass": {
          "title": "脂肪總重",
          "formula": "體重 × 體脂率",
          "desc": "體內皮下脂肪與內臟脂肪的客觀物理總量，直接呈現脂肪儲備現狀。"
        },
        "vTaperRatio": {
          "title": "胸腰比",
          "formula": "胸圍 / 腰圍",
          "desc": "評估上半身倒三角形態發達程度的客觀幾何常數。以胸部最大圍度除以腰部最細圍度，量化背闊肌與胸部相對腰腹的幾何輪廓。"
        },
        "whRatio": {
          "title": "腰臀比",
          "formula": "腰圍 / 臀圍",
          "desc": "世界衛生組織衡量身體脂肪分佈與體態幾何比例的客觀指標。以腰圍除以臀圍，量化軀幹中心向骨盆過渡的生理形態。"
        }
