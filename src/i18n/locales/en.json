      "metricGuides": {
        "weight": {
          "desc": "Total physical mass of all bodily tissues and fluids; the primary baseline metric for energy balance and body composition.",
          "method": "Weigh in the morning after voiding and before eating or drinking, wearing minimal clothing, standing still on a flat, hard surface."
        },
        "bodyFat": {
          "desc": "Percentage of total body weight composed of adipose tissue, reflecting lean mass versus fat distribution.",
          "method": "Measure using BIA, DEXA scan, or calipers under consistent hydration and physiological conditions."
        },
        "shouldersCm": {
          "desc": "Horizontal distance across the outermost points of the lateral deltoids, quantifying upper torso frame.",
          "method": "Stand upright with relaxed shoulders and arms at sides; wrap a tape measure horizontally around the widest protrusion of both deltoids."
        },
        "chestCm": {
          "desc": "Circumference of the thorax across the widest point of the pectoral muscles, reflecting chest frame and torso development.",
          "method": "Stand naturally with arms relaxed at sides; place tape horizontally around the nipple line and across the shoulder blades at the end of a normal exhalation."
        },
        "waistCm": {
          "desc": "Circumference at the narrowest point of the torso, serving as a primary marker for visceral fat and torso taper ratio.",
          "method": "Stand upright with abdomen relaxed; wrap tape horizontally midway between the lowest rib and top of the iliac crest at the end of a normal exhalation."
        },
        "hipsCm": {
          "desc": "Circumference around the widest part of the buttocks and pelvis, used to calculate waist-to-hip ratio and lower body structure.",
          "method": "Stand upright with feet together; wrap tape horizontally around the maximal protrusion of the glutes, keeping tape parallel to the floor."
        },
        "armsCm": {
          "desc": "Maximal circumference around the upper arm, measuring muscular development of the biceps and triceps.",
          "method": "Measure around the peak of the biceps perpendicular to the long axis of the humerus, either relaxed or flexed (maintain consistent method)."
        },
        "thighsCm": {
          "desc": "Circumference around the thickest portion of the thigh, reflecting quadriceps and hamstrings mass.",
          "method": "Stand with feet shoulder-width apart and weight distributed evenly; wrap tape horizontally around the maximal girth of the thigh just below the gluteal fold."
        },
        "calvesCm": {
          "desc": "Maximal horizontal circumference around the gastrocnemius and soleus muscles of the lower leg.",
          "method": "Stand naturally with weight evenly distributed; wrap tape horizontally around the widest point of the calf muscle belly."
        }
      },
