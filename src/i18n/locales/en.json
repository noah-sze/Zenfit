      "metricExplanations": {
        "formula": "Formula",
        "trendWeight": {
          "title": "Smoothed Weight",
          "formula": "7-Day Smoothing (Today 15% + History 85%)",
          "desc": "Daily scale weight fluctuates by 1~2kg due to water retention, sodium, and digestion. By blending 85% historical baseline with 15% daily weight over a 7-day window, it filters out transient noise to objectively track true changes in fat and muscle tissue."
        },
        "bmi": {
          "title": "BMI",
          "formula": "Weight (kg) / Height (m)²",
          "desc": "Standard WHO metric assessing weight-to-height ratio to objectively quantify baseline body dimensions."
        },
        "ffmi": {
          "title": "FFMI",
          "formula": "Lean Mass (kg) / Height (m)²",
          "desc": "Fat-free mass index excluding adipose tissue to measure muscular development relative to height."
        },
        "leanBodyMass": {
          "title": "Lean Body Mass",
          "formula": "Weight × (1 - Body Fat %)",
          "desc": "Total body mass excluding all adipose tissue, encompassing bones, skeletal muscles, internal organs, and fluids."
        },
        "fatMass": {
          "title": "Fat Mass",
          "formula": "Weight × Body Fat %",
          "desc": "Absolute physical weight of total subcutaneous and visceral adipose tissue in the body."
        },
        "vTaperRatio": {
          "title": "Chest-to-Waist Ratio",
          "formula": "Chest / Waist",
          "desc": "Objective geometric ratio evaluating upper body V-taper development, quantifying chest and lat proportion relative to the waist."
        },
        "whRatio": {
          "title": "Waist-to-Hip Ratio",
          "formula": "Waist / Hip",
          "desc": "Standard objective metric established by the WHO assessing body fat distribution and trunk proportions, measuring waist circumference relative to the hips."
        }
      },
